# scripts/x402-poc/.env. Key names match gateway/.env and agent-client/.env (HANDOFF §8).
# server
PORT=8090
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera:testnet
# Treasury Hedera account ID (0.0.x; EVM aliases are rejected)
X402_PAY_TO=
X402_POC_MODEL=Qwen/Qwen3-14B-FP8
X402_POC_MAX_TOKENS=512
# client (SPENDS TESTNET HBAR)
X402_POC_URL=http://127.0.0.1:8090/echo?msg=hello
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# ecdsa (default; the only key type the package's live tests cover) | ed25519
AGENT_KEY_TYPE=ecdsa
AGENT_BUDGET_HBAR=1
HEDERA_NETWORK=testnet
HASHSCAN_URL=https://hashscan.io/testnet
