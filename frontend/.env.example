# Copy to .env.local. Everything here ships to the browser bundle:
# NEVER put private keys, the World RP signing key, the gateway signing key,
# Hedera operator / settler keys or Arkiv keys in VITE_* vars.

# mock = seeded fixtures (no backend needed) · live = gateway + Hedera mirror node
VITE_DATA_MODE=mock

# Gateway (spec v0.1 §5.2). Leave empty to use the same origin through the dev/preview proxy.
VITE_GATEWAY_URL=http://127.0.0.1:8080

# World ID (IDKit v4, spec §6): public app id and the login action only.
VITE_WORLD_APP_ID=
VITE_WORLD_ACTION=gpupool-account

# Hedera testnet EVM (chain id 296)
VITE_HEDERA_RPC=https://testnet.hashio.io/api
# EpochPayout.sol (spec §10.5), for claims from /payouts
VITE_PAYOUT_ADDR=
# HCS ledger topic (gpupool-ledger) and the mirror node used to check its messages
VITE_HCS_TOPIC=
VITE_MIRROR_URL=https://testnet.mirrornode.hedera.com

