# Copy to pool/node.env (ROLE=node) on each node. On the coordinator ALSO copy to
# pool/scheduler.env with ROLE=scheduler, TCP_PORT/UDP_PORT=5100 (the coordinator runs both).
# Ports: scheduler 5100, Linux node 5101, Mac nodes 5102, 5103 (TCP+UDP).
PARALLAX_DIR=$HOME/parallax
ROLE=node                 # scheduler | node
MODEL=Qwen/Qwen3-14B-FP8  # scheduler only (nodes get their layers from the scheduler)
INIT_NODES=3              # scheduler only
DHT_PREFIX=gpupool-x7k2
LAN_IP=
TCP_PORT=5101
UDP_PORT=5101
HF_HOME=                  # model cache; Mac 14B MLX: <parallax>/.cache/huggingface
EXTRA_FLAGS=              # Mac: "--kv-cache-memory-fraction 0.25 --max-sequence-length 4096" (quote it)
CUDA_HOME=                # CUDA nodes: $PARALLAX_DIR/.venv/lib/python3.12/site-packages/nvidia/cu13
