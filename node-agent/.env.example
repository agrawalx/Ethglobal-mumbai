GATEWAY_URL=http://10.73.185.71:8080
# Frontend base for the registration link (gpupool-node init)
FRONTEND_URL=http://10.73.185.71:3000
NODE_KEY_PATH=~/.gpupool/node.key
POOL_ID=pool-lab-1
IS_COORDINATOR=false
POOL_KEY_PATH=~/.gpupool/pool.key
# Coordinator only: hashed into gpupool.pool coordinator_url_hash (the URL stays private)
COORDINATOR_URL=http://127.0.0.1:3001
# Parallax node log the layer range is read from (pool/join-node.sh writes pool/logs/node.log)
PARALLAX_NODE_LOG=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=
HEARTBEAT_SECONDS=10
ARKIV_EXTEND_SECONDS=30
# Post-MVP P5 (docs/POST_MVP_PLAN.md)
# true = run pool/restart.sh on a gateway restart order (P5.5) or a LAN IP change (P5.6); false = print the command
AUTO_RESTART=false
RESTART_JOIN_DELAY_S=15
# Defaults: <repo>/pool, pool/node.env, pool/run/node.peer-id; NOTIFY_PORT defaults to pool/node.env
POOL_DIR=
POOL_NODE_ENV=
PEER_ID_FILE=
NOTIFY_PORT=
SWAP_GROWTH_MB=256
SWAP_WINDOW_S=300
