{
  "name": "@gpupool/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:demo": "node --test test/backend-demo.test.ts",
    "demo:privacy": "node scripts/privacy-demo.ts",
    "demo:incentives": "node scripts/incentives-demo.ts",
    "verify": "node --env-file-if-exists=.env scripts/verify-backend.ts"
  },
  "dependencies": {
    "@gpupool/shared": "workspace:*",
    "@hiero-ledger/sdk": "2.90.1",
    "@hono/node-server": "^2.1.6",
    "@worldcoin/idkit-core": "4.6.0",
    "@x402/core": "2.30.0",
    "@x402/hedera": "2.30.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "viem": "^2.57.16",
    "zod": "^4.6.7",
    "@gpupool/arkiv": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
