# gateway/.env (HANDOFF §8). Required to start: POOL_COORDINATOR_URL, DATABASE_PATH, GATEWAY_SIGNING_KEY.
# World login needs JWT_SECRET + WORLD_*; x402 needs X402_*; HCS needs HEDERA_OPERATOR_* + HCS_TOPIC_ID.
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://10.73.185.71:8080
POOL_COORDINATOR_URL=http://127.0.0.1:3001
DATABASE_PATH=./data/gateway.sqlite
CORS_ORIGINS=http://localhost:3000
POOL_TIMEOUT_MS=600000

# Step 2.1 (World login) / 2.2 (ledger) / 2.3 (HCS)
JWT_SECRET=
GATEWAY_SIGNING_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=gpupool-account
WORLD_ENVIRONMENT=staging
STARTER_CREDITS=10000
STARTER_EXPIRY_DAYS=14

# Hedera (2.3, 2.4, 3.3)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera:testnet
X402_PAY_TO=
SETTLER_PRIVATE_KEY=
PAYOUT_CONTRACT_ADDRESS=
EPOCH_SECONDS=600

# Arkiv (3.1)
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
