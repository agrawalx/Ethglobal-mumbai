# gateway/.env (HANDOFF §8). Required to start: POOL_COORDINATOR_URL, DATABASE_PATH, GATEWAY_SIGNING_KEY.
# World login needs JWT_SECRET + WORLD_*; x402 needs X402_*; HCS needs HEDERA_OPERATOR_* + HCS_TOPIC_ID.
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://10.73.185.71:8080
POOL_COORDINATOR_URL=http://127.0.0.1:3001
DATABASE_PATH=./data/gateway.sqlite
# Dev phase: a database from another schema version is moved aside (gateway.sqlite-bak-vN-<time>) and recreated. false = refuse to start.
DB_RESET_ON_MISMATCH=true
CORS_ORIGINS=http://localhost:3000
# Non-streaming only; streaming uses shared config resilience.first_token_* (post-MVP P5.1).
POOL_TIMEOUT_MS=600000
# Must match node-agent HEARTBEAT_SECONDS (uptime sampling interval).
HEARTBEAT_SECONDS=10

# Step 2.1 (World login) / 2.2 (ledger) / 2.3 (HCS)
JWT_SECRET=
GATEWAY_SIGNING_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=gpupool-account
WORLD_ENVIRONMENT=staging
STARTER_CREDITS=10000
STARTER_EXPIRY_DAYS=14

# Hedera (2.3, 2.4, 3.3)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.11331600
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=hedera:testnet
X402_PAY_TO=
# Epoch worker: ECDSA keys; reserves these wallets for settlement transactions.
# Treasury sends provider funds to the settler; settler must already have HBAR for gas.
SETTLER_PRIVATE_KEY=
# Set this address to enable automatic settlement (requires HCS + treasury/settler keys).
PAYOUT_CONTRACT_ADDRESS=
EPOCH_SECONDS=600

# Arkiv (3.1)
# Read-only routing/discovery uses RPC/chain/access key; no writer key is needed.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=

# Optional live verification CLI only; never required by the gateway server.
# A session token for an idle requester account. --inference explicitly spends its credits.
VERIFY_SESSION_TOKEN=

# Post-MVP P5 (docs/POST_MVP_PLAN.md). Absolute paths on the scheduler host; empty = off.
# Allow-list the scheduler hook reads (pool/scheduler.env ALLOWED_PEERS_FILE must be the same file).
PARALLAX_ALLOWED_PEERS_FILE=
# Hook route log (<repo>/pool/run/routes.jsonl). Set ONLY when the scheduler runs with pool/hooks.
PARALLAX_ROUTE_LOG=

# SPEC §16.2 output verification: both reference services must be trusted and independently calibrated.
# Leave VERIFIER_URL empty until a reference implementation has a valid model and calibration set.
VERIFIER_URL=
VERIFIER_OWNER_ACCOUNT=
VERIFIER_SECONDARY_URL=
VERIFIER_SECONDARY_OWNER_ACCOUNT=
VERIFICATION_MAX_RATE=0.2
VERIFICATION_MIN_RATE=0.005
VERIFICATION_COST_MC=1
VERIFICATION_APPEAL_HOURS=24
# SPEC §16.1 many pools: {"pool-id":"http://127.0.0.1:3102"} and/or the file pool/pools-up.sh writes.
POOL_COORDINATORS=
POOL_COORDINATORS_FILE=
# SPEC §16.1 privacy: acc_ IDs trusted with the first and last layers (x-gpupool-privacy: trusted-ends)
# SPEC §16.3 private pools: {"pool-id":["acc_…"]}
PRIVATE_POOLS=
TRUSTED_ACCOUNTS=
# Privacy (SPEC §5.6): transcript encryption key (openssl rand -hex 32) and HTTPS certificate files.
TRANSCRIPT_KEY=
TLS_CERT_FILE=
TLS_KEY_FILE=
