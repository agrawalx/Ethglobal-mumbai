HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
DEPLOYER_PRIVATE_KEY=
SETTLER_ADDRESS=
CLAIM_DELAY_SECONDS=60
# Settler may sweep unclaimed HBAR back after this many seconds (default 7 days)
SWEEP_DELAY_SECONDS=604800

# EpochPayoutV2 (SPEC §16.4): script/DeployV2.s.sol
OWNER_ADDRESS=                    # resolves disputes (later: a multisig); default = deployer
TREASURY_ADDRESS=                 # receives swept and clawed-back value
GATEWAY_INDEX=0                   # this settler's namespace (epoch ids = index × 2^32 + n)
CHALLENGE_WINDOW_SECONDS=3600     # claims closed and challengeable; use 60 for the demo
DISPUTE_TIMEOUT_SECONDS=172800    # after this anyone can dismiss an unanswered challenge
MAX_VESTING_SECONDS=2592000       # longest vesting unlock a settler may set (30 days)
MAX_EPOCH_TOTAL_TINYBAR=0         # per-epoch cap; 0 = none
