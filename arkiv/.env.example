# arkiv/.env (used by src/cli.ts; the gateway and node agent pass the same keys)
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
# hub.arkiv.network/access-keys (appended to the RPC URL path; empty = public rate-limited endpoint)
ARKIV_ACCESS_KEY=
# Writer key: 0x hex, OR a key file path (node agent: ~/.gpupool/node.key, coordinator: ~/.gpupool/pool.key)
ARKIV_PRIVATE_KEY=
ARKIV_KEY_PATH=
ARKIV_EXTEND_SECONDS=30
